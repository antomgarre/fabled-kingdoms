{
    auto_https off
}

:{$PORT:3000} {
    root * /srv
    encode zstd gzip

    # Health check for Railway probes
    respond /health 200

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Hashed assets: 1-year immutable cache; missing assets return 404
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Static images and root icons: cache for 1 day
    @images path *.png *.svg *.ico *.jpg *.webp
    handle @images {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # Single Page Application fallback: ensure index.html is never cached
    handle {
        try_files {path} /index.html
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}
